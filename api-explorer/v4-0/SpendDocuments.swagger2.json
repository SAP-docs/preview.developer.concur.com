{
  "swagger": "2.0",
  "info": {
    "title": "Spend Documents",
    "description": "Allows certified vendors to submit compliant receipts and compliance documents to the SAP Concur platform on behalf of users. The workflow involves posting a display version of the receipt with the required data, then uploading the compliance document via PUT. Suited for certified receipt providers and tax compliance integrations.",
    "version": "4.0"
  },
  "externalDocs": {
    "description": "API Reference",
    "url": "https://developer.concur.com/api-reference/spend-documents/v4.spend-documents.html"
  },
  "x-sap-shortText": "Ingests and retrieves compliance receipts and spend documents",
  "host": "eu2.api.concursolutions.com",
  "basePath": "/spend-documents/v4",
  "schemes": [
    "https"
  ],
  "security": [
    {
      "JWT-Authentication": []
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/hal+json"
  ],
  "tags": [
    {
      "name": "Spend Documents",
      "description": "Receipts API"
    }
  ],
  "paths": {
    "/receipts/{receiptId}": {
      "get": {
        "tags": [
          "Spend Documents"
        ],
        "summary": "Get receipt details by Receipt Id",
        "description": "This API will get receipt details by Receipt Id.",
        "operationId": "getReceipt",
        "parameters": [
          {
            "name": "receiptId",
            "in": "path",
            "description": "Receipt UUID",
            "required": true,
            "type": "string"
          },
          {
            "name": "concur-correlationid",
            "in": "header",
            "description": "Concur Correlation ID",
            "required": true,
            "type": "string",
            "default": "ris_swagger_test_1"
          },
          {
            "name": "concur-forwarded-for",
            "in": "header",
            "description": "Concur forward-for cert name",
            "required": true,
            "type": "string",
            "default": "com.concur.qa.platform.receipts"
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt Retrieved",
            "schema": {
              "$ref": "#/definitions/BaseReceipt_Public"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage_Public"
            }
          }
        }
      }
    },
    "/receipts": {
      "get": {
        "tags": [
          "Spend Documents"
        ],
        "summary": "Get receipt details by forwardId or imageId and companyId.",
        "description": "This API will get receipt details by forwardId or imageId and companyId.",
        "operationId": "getReceiptByForwardIdOrImageId",
        "parameters": [
          {
            "name": "forwardId",
            "in": "query",
            "description": "Forward Id UUID",
            "required": false,
            "type": "string"
          },
          {
            "name": "imageId",
            "in": "query",
            "description": "Image UUID",
            "required": false,
            "type": "string"
          },
          {
            "name": "companyId",
            "in": "query",
            "description": "Company UUID",
            "required": false,
            "type": "string"
          },
          {
            "name": "concur-correlationid",
            "in": "header",
            "description": "Concur Correlation ID",
            "required": true,
            "type": "string",
            "default": "ris_swagger_test_1"
          },
          {
            "name": "concur-forwarded-for",
            "in": "header",
            "description": "Concur forward-for cert name",
            "required": true,
            "type": "string",
            "default": "com.concur.qa.platform.receipts"
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt Retrieved",
            "schema": {
              "$ref": "#/definitions/BaseReceipt"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          }
        }
      },
      "post": {
        "tags": [
          "Spend Documents"
        ],
        "summary": "Post a new receipt.",
        "description": "This API will create new receipts.",
        "operationId": "postReceipt",
        "parameters": [
          {
            "name": "concur-correlationid",
            "in": "header",
            "description": "Concur Correlation ID",
            "required": true,
            "type": "string",
            "default": "ris_swagger_test_1"
          },
          {
            "name": "concur-forwarded-for",
            "in": "header",
            "description": "Concur forward-for cert name",
            "required": true,
            "type": "string",
            "default": "com.concur.qa.platform.receipts"
          },
          {
            "name": "receipt",
            "in": "formData",
            "description": " (JSON string)",
            "required": true,
            "type": "string"
          },
          {
            "name": "document",
            "in": "formData",
            "description": "Receipt image to upload. Compatible formats: PDF, JPEG, PNG, GIF, JPG",
            "required": false,
            "type": "file"
          }
        ],
        "responses": {
          "202": {
            "description": "Receipt Accepted",
            "schema": {
              "$ref": "#/definitions/BaseReceiptResponse"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          }
        },
        "consumes": [
          "multipart/form-data"
        ]
      }
    },
    "/receipts/{receiptId}/representations": {
      "get": {
        "tags": [
          "Spend Documents"
        ],
        "summary": "Get receipt representations by receiptId.",
        "description": "This API returns display or compliance representation of a receipt by receipt Id.",
        "operationId": "getDocumentsByReceiptId",
        "parameters": [
          {
            "name": "receiptId",
            "in": "path",
            "description": "Receipt UUID",
            "required": true,
            "type": "string"
          },
          {
            "name": "type",
            "in": "query",
            "description": "Representation Type",
            "required": false,
            "type": "string",
            "default": "display"
          },
          {
            "name": "concur-correlationid",
            "in": "header",
            "description": "Concur Correlation ID",
            "required": true,
            "type": "string",
            "default": "ris_swagger_test_1"
          },
          {
            "name": "concur-forwarded-for",
            "in": "header",
            "description": "Concur forward-for cert name",
            "required": true,
            "type": "string",
            "default": "com.concur.qa.platform.receipts"
          }
        ],
        "responses": {
          "200": {
            "description": "Receipt Representations Retrieved",
            "schema": {
              "type": "string",
              "format": "binary"
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "$ref": "#/definitions/ErrorMessage"
            }
          }
        }
      }
    },
    "/receipts/representations": {
      "get": {
